# Ignore everything in the plural projects folder
public/projects/**/*

# Allow the directory structure itself
!public/projects/**/
public/projects/ToSort

# Allow only the small metadata and optimized assets
!public/projects/**/*.webp
!public/projects/**/*.json

# --- Environment Secrets ---
# .env alone does NOT match .env.local / .env.development / etc.
# Until 2026-08-02 those were only saved incidentally by the *.local rule
# further down, which exists for Vite build artifacts, not secrets.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
*kate-swp*

dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
